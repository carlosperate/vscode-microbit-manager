{
  "name": "bbcmicrobit-manager",
  "displayName": "BBC micro:bit Manager",
  "description": "Connect to a BBC micro:bit over WebUSB, flash a hex file and open a serial terminal. Shared by the micro:bit language extensions.",
  "version": "0.1.0",
  "publisher": "carlosperate",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlosperate/vscode-microbit-manager.git"
  },
  "bugs": {
    "url": "https://github.com/carlosperate/vscode-microbit-manager/issues"
  },
  "homepage": "https://github.com/carlosperate/vscode-microbit-manager#readme",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "microbit",
    "bbcmicrobit",
    "bbc-microbit",
    "webusb",
    "serial",
    "embedded"
  ],
  "main": "./dist/node.js",
  "browser": "./dist/browser.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "extensionPack": [
    "eclipse-cdt.serial-monitor"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bbcmicrobit",
          "title": "BBC micro:bit Manager",
          "icon": "assets/activitybar.svg"
        }
      ]
    },
    "views": {
      "bbcmicrobit": [
        {
          "id": "bbcmicrobit-manager.board",
          "name": "BBC micro:bit Manager",
          "icon": "assets/activitybar.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bbcmicrobit-manager.board",
        "contents": "[$(plug) Connect](command:bbcmicrobit-manager.connect)",
        "when": "bbcmicrobit-manager.canPair"
      },
      {
        "view": "bbcmicrobit-manager.board",
        "contents": "[$(zap) Flash hex to micro:bit](command:bbcmicrobit-manager.flashHexFile)\n[$(terminal) Open Serial Terminal](command:bbcmicrobit-manager.openTerminal)"
      },
      {
        "view": "bbcmicrobit-manager.board",
        "contents": "To write programs for the micro:bit, add a language:\n[Add MicroPython support](command:extension.open?%5B%22carlosperate.bbcmicrobit-micropython%22%5D)\n[Add C++ support](command:extension.open?%5B%22carlosperate.bbcmicrobit-cpp%22%5D)",
        "when": "bbcmicrobit-manager.offerMicroPython && bbcmicrobit-manager.offerCpp"
      },
      {
        "view": "bbcmicrobit-manager.board",
        "contents": "To write programs for the micro:bit, add a language:\n[Add MicroPython support](command:extension.open?%5B%22carlosperate.bbcmicrobit-micropython%22%5D)",
        "when": "bbcmicrobit-manager.offerMicroPython && !bbcmicrobit-manager.offerCpp"
      },
      {
        "view": "bbcmicrobit-manager.board",
        "contents": "To write programs for the micro:bit, add a language:\n[Add C++ support](command:extension.open?%5B%22carlosperate.bbcmicrobit-cpp%22%5D)",
        "when": "!bbcmicrobit-manager.offerMicroPython && bbcmicrobit-manager.offerCpp"
      }
    ],
    "commands": [
      {
        "command": "bbcmicrobit-manager.connect",
        "title": "Connect",
        "category": "BBC micro:bit Manager"
      },
      {
        "command": "bbcmicrobit-manager.disconnect",
        "title": "Disconnect",
        "category": "BBC micro:bit Manager"
      },
      {
        "command": "bbcmicrobit-manager.flashHexFile",
        "title": "Flash hex to micro:bit",
        "category": "BBC micro:bit Manager"
      },
      {
        "command": "bbcmicrobit-manager.openTerminal",
        "title": "Open Serial Terminal",
        "category": "BBC micro:bit Manager"
      },
      {
        "command": "bbcmicrobit-manager.showMenu",
        "title": "Show Menu",
        "category": "BBC micro:bit Manager"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "bbcmicrobit-manager.flashHexFile",
          "when": "resourceExtname =~ /\\.hex$/i",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "bbcmicrobit-manager.showMenu",
          "when": "false"
        },
        {
          "command": "bbcmicrobit-manager.connect",
          "when": "bbcmicrobit-manager.canPair"
        },
        {
          "command": "bbcmicrobit-manager.disconnect",
          "when": "bbcmicrobit-manager.canPair"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node config/esbuild.config.mjs",
    "build:icon": "node config/build-icon.mjs",
    "build:integration": "esbuild test/integration/index.ts --bundle --outfile=test/integration/dist/index.js --format=cjs --platform=browser --main-fields=module,browser,main --external:vscode --log-level=warning",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/node && tsc --noEmit -p test",
    "test": "vitest run --config config/vitest.config.mts",
    "test:watch": "vitest --config config/vitest.config.mts",
    "test:all": "npm run typecheck && npm run build && npm test && npm run test:integration && npm run test:integration:desktop",
    "test:integration": "npm run build && npm run build:integration && vscode-test-web --quality stable --headless --port=3001 --extensionDevelopmentPath=. --extensionPath=./test/fixtures/fake-language --extensionTestsPath=./test/integration/dist/index.js ./test/workspace",
    "test:integration:desktop": "npm run build && npm run build:integration && node config/desktop.mjs --test --extensionPath=test/fixtures/fake-language",
    "serve": "npm run build && vscode-test-web --quality stable --browser=none --port=3000 --extensionDevelopmentPath=. ./test/workspace",
    "serve:languages": "node config/with-extensions.mjs --extensionId=carlosperate.bbcmicrobit-micropython --extensionId=carlosperate.bbcmicrobit-cpp",
    "chrome": "npm run build && vscode-test-web --quality stable --browser=chromium --extensionDevelopmentPath=. ./test/workspace",
    "chrome:languages": "node config/with-extensions.mjs --chrome --extensionId=carlosperate.bbcmicrobit-micropython --extensionId=carlosperate.bbcmicrobit-cpp",
    "desktop": "npm run build && node config/desktop.mjs",
    "desktop:languages": "node config/with-extensions.mjs --desktop --extensionId=carlosperate.bbcmicrobit-micropython --extensionId=carlosperate.bbcmicrobit-cpp"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "1.91.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/w3c-web-usb": "1.0.14",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@microbit/microbit-connection": "1.0.0",
    "@microbit/microbit-universal-hex": "0.2.2"
  }
}
