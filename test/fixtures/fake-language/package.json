{
  "name": "fake-language",
  "displayName": "Fake Language",
  "description": "A stand-in language extension for the bench and the integration tests. Registers one menu group, with a sidebar of one view, with the BBC micro:bit Manager.",
  "version": "0.0.1",
  "publisher": "bbcmicrobit-test",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./extension.js",
  "browser": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "carlosperate.bbcmicrobit-manager"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fake-language",
          "title": "Fake Language",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "fake-language": [
        {
          "id": "fake-language.panel",
          "name": "Fake Language"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fake-language.panel",
        "contents": "The fake language's own panel.\n[Flash (fake)](command:fake-language.flash)"
      }
    ],
    "commands": [
      {
        "command": "fake-language.flash",
        "title": "Flash (fake)",
        "category": "Fake Language"
      }
    ]
  }
}
