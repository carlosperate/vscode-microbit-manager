{
  "name": "fake-mode-plain",
  "displayName": "Plain Mode",
  "description": "A mode that offers no Flash button and no serial terminal, because nothing it does touches a board. It stands in for an editor-configuration mode in the bench.",
  "version": "0.0.1",
  "publisher": "bbcmicrobit-test",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./extension.js",
  "browser": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "carlosperate.bbcmicrobit-manager"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "views": {
      "bbcmicrobit": [
        {
          "id": "fake-mode-plain.panel",
          "name": "Plain Mode",
          "when": "bbcmicrobit-manager.activeMode == plain"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fake-mode-plain.panel",
        "contents": "This mode has no Flash button and no serial terminal, because nothing it does touches a board.\n[$(gear) Say Hello](command:fake-mode-plain.hello)"
      }
    ],
    "commands": [
      {
        "command": "fake-mode-plain.hello",
        "title": "Say Hello",
        "category": "Plain Mode"
      }
    ]
  }
}
