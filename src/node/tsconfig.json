{
	// The desktop entry really does run in node, so this is the one part of `src/`
	// that gets node's types, and the root project excludes this folder: anywhere
	// else they would let `process`, `Buffer` and `__dirname` compile and then throw
	// in the Web Worker. It sits here rather than at the repo root so an editor
	// picks it up too: tsserver uses the nearest tsconfig above the file it checks.
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2020"],
		"types": ["vscode", "node", "w3c-web-serial", "w3c-web-usb"]
	},
	// The root's `exclude` is this very folder, and it is inherited, so it has to
	// be replaced rather than extended.
	"exclude": ["../../node_modules", "../../dist"],
	"include": ["**/*.ts"]
}
